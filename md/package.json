{
  "name": "@closedose-md/platform",
  "version": "0.1.0",
  "private": true,
  "description": "CloseDose MD provider platform workspace",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/portal",
    "apps/pig",
    "apps/rsi",
    "apps/airway-scenarios",
    "apps/post-intubation",
    "apps/rsi-timeline",
    "apps/airway-transport",
    "apps/pmd",
    "apps/device",
    "apps/sedation",
    "packages/rsi-reference"
  ],
  "scripts": {
    "build": "node scripts/build.mjs production",
    "build:review": "node scripts/build.mjs review",
    "build:portal": "npm run build --workspace @closedose-md/portal",
    "build:pig": "npm run build --workspace @closedose-md/pig",
    "build:rsi": "npm run build --workspace @closedose-md/rsi",
    "build:airway-scenarios": "npm run build --workspace @closedose-md/airway-scenarios",
    "build:post-intubation": "npm run build --workspace @closedose-md/post-intubation",
    "build:rsi-timeline": "npm run build --workspace @closedose-md/rsi-timeline",
    "build:airway-transport": "npm run build --workspace @closedose-md/airway-transport",
    "build:pmd": "npm run build --workspace @closedose-md/pmd",
    "build:device": "npm run build --workspace @closedose-md/device",
    "build:sedation": "npm run build --workspace @closedose-md/sedation",
    "typecheck": "npm run typecheck:portal && npm run typecheck:pig && npm run typecheck:rsi-reference && npm run typecheck:rsi && npm run typecheck:airway-scenarios && npm run typecheck:post-intubation && npm run typecheck:rsi-timeline && npm run typecheck:airway-transport && npm run typecheck:pmd && npm run typecheck:device && npm run typecheck:sedation",
    "typecheck:portal": "npm run typecheck --workspace @closedose-md/portal",
    "typecheck:pig": "npm run typecheck --workspace @closedose-md/pig",
    "typecheck:rsi": "npm run typecheck --workspace @closedose-md/rsi",
    "typecheck:rsi-reference": "npm run typecheck --workspace @closedose-md/rsi-reference",
    "typecheck:airway-scenarios": "npm run typecheck --workspace @closedose-md/airway-scenarios",
    "typecheck:post-intubation": "npm run typecheck --workspace @closedose-md/post-intubation",
    "typecheck:rsi-timeline": "npm run typecheck --workspace @closedose-md/rsi-timeline",
    "typecheck:airway-transport": "npm run typecheck --workspace @closedose-md/airway-transport",
    "typecheck:pmd": "npm run typecheck --workspace @closedose-md/pmd",
    "typecheck:device": "npm run typecheck --workspace @closedose-md/device",
    "typecheck:sedation": "npm run typecheck --workspace @closedose-md/sedation",
    "test:portal": "npm run test --workspace @closedose-md/portal",
    "test:pig": "npm run test --workspace @closedose-md/pig",
    "test:rsi": "npm run test --workspace @closedose-md/rsi",
    "test:pmd": "npm run test --workspace @closedose-md/pmd",
    "test:device": "npm run test --workspace @closedose-md/device",
    "test:sedation": "npm run test --workspace @closedose-md/sedation",
    "test:rules": "npx --yes --package=firebase-tools@15.24.0 -- firebase emulators:exec --project demo-closedose-md --only firestore \"node --test tests/firestore-rules.test.mjs\"",
    "test:unit": "node --test tests/workspace-contract.test.mjs tests/clinical-release-manifest.test.mjs tests/provider-specs.test.mjs tests/portal.test.mjs tests/pig.test.mjs tests/rsi.test.mjs tests/pmd.test.mjs tests/device.test.mjs tests/sedation.test.mjs tests/pmd-migration.test.mjs tests/pmd-shift-access.test.mjs tests/privacy-scanner.test.mjs tests/release-hardening.test.mjs",
    "test:contract": "node --test tests/distribution-contract.test.mjs",
    "test:smoke": "playwright test",
    "migrate:pmd": "node scripts/migrate-pmd-legacy-shifts.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "@google-cloud/firestore": "8.7.0",
    "@playwright/test": "^1.61.1"
  },
  "overrides": {
    "google-gax": {
      "rimraf": "6.1.3"
    }
  }
}
